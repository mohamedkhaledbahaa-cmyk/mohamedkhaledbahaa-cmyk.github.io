---
import Tag from '../../../views/Tag.astro';
import { getArticles } from '../../../lib/utils';
export async function getStaticPaths() {
  const articles = await getArticles('en');
  const tags = [...new Set(articles.flatMap((a) => a.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { articles: articles.filter((a) => a.data.tags.includes(tag)) } }));
}
---
<Tag lang="en" tag={Astro.params.tag!} articles={Astro.props.articles} />
