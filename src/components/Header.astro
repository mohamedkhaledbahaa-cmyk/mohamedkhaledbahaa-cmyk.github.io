---
import { SITE } from '../config';
import { t, url, type Lang } from '../i18n';
interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const L = t(lang);
const path = Astro.url.pathname;
const home = url(lang, '/');
const links = [
  { href: home, label: L.nav.home },
  { href: url(lang, '/blog/'), label: L.nav.articles },
  { href: url(lang, '/pricing/'), label: L.navShort.pricing, icon: '⚡' },
  { href: url(lang, '/cables/'), label: L.navShort.cables, icon: '🔌' },
  { href: url(lang, '/lighting/'), label: L.navShort.lights, icon: '💡' },
  { href: url(lang, '/about/'), label: L.nav.about },
];
const isActive = (href: string) => (href === home ? path === home || path === home.slice(0, -1) : path.startsWith(href));
---
<header class="site-header">
  <nav class="container nav" aria-label={L.menu}>
    <a href={home} class="brand" dir="ltr"><img src="/logo-96.webp" alt="" width="44" height="44" />{SITE.title}</a>
    <ul class="nav-links" id="nav-links">
      {links.map((l: { href: string; label: string; icon?: string }) => <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.icon && <span class="nav-ico" aria-hidden="true">{l.icon}</span>}{l.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <a href={altHref} class="icon-btn lang-btn" aria-label={L.switchLangLabel} lang={lang === 'ar' ? 'en' : 'ar'}>{lang === 'ar' ? 'EN' : 'ع'}</a>
      <a href={url(lang, '/search/')} class="icon-btn" aria-label={L.search}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <button class="icon-btn" id="theme-toggle" aria-label={L.toggleTheme}>
        <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-btn" id="menu-toggle" aria-label={L.menu} aria-expanded="false" aria-controls="nav-links">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>
</header>
<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  const menu = document.getElementById('menu-toggle');
  menu?.addEventListener('click', () => {
    const open = document.getElementById('nav-links')!.classList.toggle('open');
    menu.setAttribute('aria-expanded', String(open));
  });
</script>
