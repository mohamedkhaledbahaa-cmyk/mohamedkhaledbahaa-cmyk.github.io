---
import { SITE } from '../config';
import { num, t, url, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t(lang);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>© {num(lang, new Date().getFullYear())} <bdi>{SITE.title}</bdi> — {L.rights}<br /><small>{L.preparedBy}: {SITE.owner[lang]}</small></div>
    <div class="footer-links">
      <a href={url(lang, '/blog/')}>{L.nav.articles}</a>
      <a href={url(lang, '/pricing/')}>{L.nav.pricing}</a>
      <a href={url(lang, '/cables/')}>{L.nav.cables}</a>
      <a href={url(lang, '/lighting/')}>{L.nav.lights}</a>
      <a href={url(lang, '/civil/')}>{L.nav.civil}</a>
      <a href={url(lang, '/tags/')}>{L.nav.tags}</a>
      <a href={url(lang, '/about/')}>{L.nav.about}</a>
      <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
</footer>
