---
import { toArabicDigits } from '../lib/utils';
interface Props { current: number; last: number; base: string }
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}${n}/`);
---
{last > 1 && (
  <nav class="pagination" aria-label="ترقيم الصفحات">
    {current > 1 && <a href={href(current - 1)}>→ السابق</a>}
    {Array.from({ length: last }, (_, i) => i + 1).map((n) =>
      n === current ? <span class="current" aria-current="page">{toArabicDigits(n)}</span> : <a href={href(n)}>{toArabicDigits(n)}</a>
    )}
    {current < last && <a href={href(current + 1)}>التالي ←</a>}
  </nav>
)}
