---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE } from '../config';
import { t, url } from '../i18n';
import { formatDate, postUrl, readingTime, tagUrl, type Article } from '../lib/utils';

interface Props { article: Article; newer?: Article; older?: Article; all: Article[] }
const { article, newer, older, all } = Astro.props;
const { title, description, date, updated, category, tags, cover, coverAlt, lang } = article.data;
const L = t(lang);
const author = article.data.author ?? L.author;
const { Content, headings } = await render(article);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const series = article.data.series ? all.filter((a) => a.data.series === article.data.series).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)) : [];
const enc = encodeURIComponent;
const related = all
  .filter((a) => a.id !== article.id)
  .map((a) => ({ a, score: (a.data.category === category ? 2 : 0) + a.data.tags.filter((x) => tags.includes(x)).length }))
  .filter((x) => x.score > 0)
  .sort((x, y) => y.score - x.score)
  .slice(0, 3)
  .map((x) => x.a);
---
<Base lang={lang} title={title} description={description} image={cover} type="article" publishedTime={date} altHref={url(lang === 'ar' ? 'en' : 'ar', '/blog/')}>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <article class="container">
    <header class="article-head">
      <a href={url(lang, `/category/${category}/`)} class="badge">{L.categories[category]}</a>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="author-line"><span class="avatar">{author.replace(/^(Eng\.|م\.)\s*/, "").charAt(0)}</span>{author}</div>
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(lang, date)}</time>
        <span class="dot"></span><span>{L.reading(readingTime(article.body))}</span>
        {updated && <><span class="dot"></span><span>{L.updatedOn(formatDate(lang, updated))}</span></>}
      </div>
    </header>

    {cover && <figure class="article-cover"><img src={cover} alt={coverAlt ?? title} width="1600" height="900" fetchpriority="high" /></figure>}

    {series.length > 1 && (
      <nav class="series-box" aria-label={L.seriesLabel}>
        <p><span>📚 {L.seriesLabel}:</span> <b>{article.data.series}</b> · {L.partOf(String(article.data.part ?? ''), String(series.length))}</p>
        <ol>{series.map((a) => <li class:list={{ current: a.id === article.id }}>{a.id === article.id ? <span>{a.data.title}</span> : <a href={postUrl(a)}>{a.data.title}</a>}</li>)}</ol>
      </nav>
    )}

    <div class="article-layout">
      <div class="prose" id="prose"><Content /></div>
      {toc.length > 1 && (
        <aside class="toc" aria-label={L.toc}>
          <h4>{L.inThisArticle}</h4>
          <ol>{toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </aside>
      )}
    </div>

    <footer class="article-foot">
      {tags.length > 0 && <div class="tags">{tags.map((x) => <a class="tag" href={tagUrl(lang, x)}># {x}</a>)}</div>}
      <div class="share">
        <strong>{L.share}</strong>
        <a class="icon-btn" aria-label="X" target="_blank" rel="noopener" href={`https://x.com/intent/tweet?text=${enc(title)}&url=${enc(pageUrl)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.8 3h3.1l-6.8 7.7 8 10.3h-6.2l-4.9-6.3L5.4 21H2.3l7.2-8.3L1.9 3h6.4l4.4 5.8L17.8 3zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5z"/></svg>
        </a>
        <a class="icon-btn" aria-label="Facebook" target="_blank" rel="noopener" href={`https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H7v4h2v7h4v-7h3l1-4h-4V9c0-.6.4-1 1-1z"/></svg>
        </a>
        <a class="icon-btn" aria-label="LinkedIn" target="_blank" rel="noopener" href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(pageUrl)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75V21h-4z"/></svg>
        </a>
        <a class="icon-btn" aria-label="WhatsApp" target="_blank" rel="noopener" href={`https://wa.me/?text=${enc(title + ' ' + pageUrl)}`}>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
        </a>
        <button class="icon-btn" id="copy-link" aria-label={L.copyLink} data-url={pageUrl} data-copied={L.copied}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
        </button>
      </div>
      <div class="author-box">
        <span class="avatar">{author.replace(/^(Eng\.|م\.)\s*/, "").charAt(0)}</span>
        <div><h4>{author}</h4><p>{L.authorBio}</p></div>
      </div>
      {(newer || older) && (
        <nav class="post-nav" aria-label={L.otherPosts}>
          {older && <a href={postUrl(older)}><small>{L.prevPost}</small>{older.data.title}</a>}
          {newer && <a class="next" href={postUrl(newer)}><small>{L.nextPost}</small>{newer.data.title}</a>}
        </nav>
      )}
    </footer>

    {related.length > 0 && (
      <section class="section" style="margin-top:40px">
        <div class="section-head"><h2>{L.related}</h2></div>
        <div class="grid">{related.map((a) => <ArticleCard article={a} />)}</div>
      </section>
    )}
  </article>
</Base>

<script>
  const bar = document.getElementById('progress-bar');
  const prose = document.getElementById('prose');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const heads = links.map((l) => document.getElementById(decodeURIComponent(l.hash.slice(1)))).filter(Boolean) as HTMLElement[];
  function onScroll() {
    if (bar && prose) {
      const r = prose.getBoundingClientRect();
      bar.style.width = `${Math.min(1, Math.max(0, -r.top / (r.height - innerHeight))) * 100}%`;
    }
    let current = heads[0];
    for (const h of heads) if (h.getBoundingClientRect().top < 120) current = h;
    links.forEach((l) => l.classList.toggle('active', decodeURIComponent(l.hash.slice(1)) === current?.id));
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  const copy = document.getElementById('copy-link');
  copy?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(copy.dataset.url!); copy.style.color = 'var(--accent)'; copy.setAttribute('aria-label', copy.dataset.copied!); } catch {}
  });
</script>
