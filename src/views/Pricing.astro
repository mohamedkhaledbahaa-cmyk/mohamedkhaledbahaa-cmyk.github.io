---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';
import { OUT_TYPES, MAIN_TYPES, IPS, BRANDS, TECH_BRANDS, FORMS } from '../lib/pricing';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = t(lang);
const ar = lang === 'ar';

const S = ar ? {
  title: 'تسعير لوحات الجهد المنخفض', lead: 'دخّل بيانات اللوحة والقواطع، وخد سعر تقريبي وعرض فني مقترح فورًا.',
  panel: 'بيانات اللوحة', project: 'اسم المشروع', panelName: 'اسم اللوحة', type: 'نوع اللوحة', mainType: 'نوع القاطع الرئيسي', mainA: 'قيمة القاطع الرئيسي (A)',
  mainPoles: 'عدد البول', incomers: 'عدد القواطع الرئيسية', incomersHint: '2 لو فيه مصدرين (ترانس + مولد)', ip: 'درجة الحماية IP', form: 'نوع الـ Form', auto: 'تلقائي',
  brand: 'ماركة المقارنة', any: 'كل الموردين', qty: 'عدد اللوحات', adj: 'نسبة تعديل / هامش %', vfd: 'عدد VFD / Soft starter إضافي (بدون kW)',
  pfc: 'اللوحة فيها باور فاكتور؟', kvar: 'قدرة الباور فاكتور (kVAR)', pfcType: 'نوع الباور فاكتور', std: 'عادي', yes: 'نعم', no: 'لا',
  outs: 'القواطع الفرعية', outType: 'نوع القاطع', outA: 'القيمة A / kW', outPoles: 'البول', outQty: 'العدد', addRow: '+ إضافة قاطع', remove: 'حذف', clear: 'مسح الكل',
  outsHint: 'الفيوز: كل مخرج = 3 بول × 1. RCBO/RCCB بتتحسب مع الـ MCB. الكونتاكتورات واللمبات والعدادات بتتضاف تلقائي في العرض الفني. قواطع الباور فاكتور ماتدخلهاش هنا.',
  result: 'النتيجة', excl: 'جنيه مصري — بدون ضريبة', unit: 'السعر المقترح للوحة الواحدة', range: 'المدى المتوقع', lowL: 'أقل سعر', highL: 'أعلى سعر',
  total: 'الإجمالي للكمية', usdL: 'بالدولار (للمرجع)', conf: 'مدى الثقة في السعر', sim: 'التشابه مع أقرب لوحة', confT: { high: 'عالي', medium: 'متوسط', low: 'ضعيف – راجع يدوي' },
  details: 'تفاصيل الحساب', panelOnly: 'سعر اللوحة (بدون باور فاكتور)', pfcP: 'سعر الباور فاكتور', m1: 'طريقة 1: أقرب لوحات عند 3 موردين', m2: 'طريقة 2: النموذج الإحصائي',
  summary: 'ملخص', outsCount: 'إجمالي المخارج', formUsed: 'الـ Form المستخدم', brk: 'تكلفة القواطع (قائمة شنايدر 2026)', dims: 'الأبعاد المقترحة', dimsTitle: 'أبعاد اللوحة التقريبية', wL: 'العرض', hL: 'الارتفاع', dL: 'العمق', mm: 'مم', colsL: 'عدد الأعمدة', legend: 'F = مخارج  •  I = قاطع رئيسي  •  A = مخرج ACB  •  P = باور فاكتور', modeT: { FLOOR: 'لوحة أرضية', WALL: 'لوحة حائطية', PIL: 'بيلر خارجي' }, dbInfo: (p: string, o: string, d: string) => `مبني على ${p} لوحة من ${o} عرض سعر حقيقي — أسعار محدّثة لتاريخ ${d}`,
  offerBtn: 'اعرض العرض الفني ←', offer: 'العرض الفني المقترح', techBrand: 'ماركة المكونات', adv: 'خيارات إضافية', ka: 'قدرة القصر kA (فاضي = تلقائي)', formO: 'Form للعرض (فاضي = من التسعير)',
  cable: 'دخول الكابلات', spd: 'إضافة SPD (حماية من الصواعق)؟', amb: 'درجة الحرارة المحيطة °C', print: 'طباعة / حفظ PDF', excel: 'تحميل Excel', loading: 'جاري تحميل قاعدة البيانات…', err: 'تعذّر تحميل البيانات. حدّث الصفحة.',
  disclaimer: 'السعر تقريبي (Budget) مبني على عروض أسعار سابقة، والفرق بين الموردين لنفس اللوحة ممكن يوصل 30–60%. استخدمه كمرجع مبدئي.',
} : {
  title: 'LV Panel Budget Estimator', lead: 'Enter the panel and breaker data to get an instant budget price and a proposed technical offer.',
  panel: 'Panel data', project: 'Project', panelName: 'Panel name', type: 'Panel type', mainType: 'Main breaker type', mainA: 'Main breaker rating (A)',
  mainPoles: 'Poles', incomers: 'Incomers', incomersHint: '2 if two sources (transformer + generator)', ip: 'Degree of protection (IP)', form: 'Form of separation', auto: 'Auto',
  brand: 'Brand to compare', any: 'All suppliers', qty: 'Number of panels', adj: 'Adjustment / margin %', vfd: 'Extra VFD / soft starters (no kW)',
  pfc: 'Includes power factor correction?', kvar: 'PFC rating (kVAR)', pfcType: 'PFC type', std: 'Standard', yes: 'Yes', no: 'No',
  outs: 'Outgoing breakers', outType: 'Type', outA: 'Rating A / kW', outPoles: 'Poles', outQty: 'Qty', addRow: '+ Add breaker', remove: 'Remove', clear: 'Clear all',
  outsHint: 'Fuse: each way = 3 poles × 1. RCBO/RCCB count with MCBs. Contactors, lamps and meters are added automatically to the technical offer. Do not enter PFC breakers here.',
  result: 'Result', excl: 'EGP — excl. VAT', unit: 'Suggested price per panel', range: 'Expected range', lowL: 'Low', highL: 'High',
  total: 'Total for quantity', usdL: 'In USD (reference)', conf: 'Price confidence', sim: 'Similarity to closest panel', confT: { high: 'High', medium: 'Medium', low: 'Low – review manually' },
  details: 'Calculation details', panelOnly: 'Panel price (excl. PFC)', pfcP: 'PFC price', m1: 'Method 1: closest panels from 3 suppliers', m2: 'Method 2: statistical model',
  summary: 'Summary', outsCount: 'Total outgoings', formUsed: 'Form used', brk: 'Breakers cost (Schneider PL 2026)', dims: 'Proposed dimensions', dimsTitle: 'Approximate panel dimensions', wL: 'Width', hL: 'Height', dL: 'Depth', mm: 'mm', colsL: 'Columns', legend: 'F = feeders  •  I = incomer  •  A = ACB outgoing  •  P = PFC', modeT: { FLOOR: 'Floor-standing', WALL: 'Wall-mounted', PIL: 'Outdoor pillar' }, dbInfo: (p: string, o: string, d: string) => `Based on ${p} panels from ${o} real supplier offers — prices updated to ${d}`,
  offerBtn: 'Show technical offer →', offer: 'Proposed technical offer', techBrand: 'Components brand', adv: 'More options', ka: 'Short-circuit kA (blank = auto)', formO: 'Offer form (blank = from estimator)',
  cable: 'Cable entry', spd: 'Add surge protection (SPD)?', amb: 'Ambient temperature °C', print: 'Print / save PDF', excel: 'Download Excel', loading: 'Loading database…', err: 'Could not load data. Please refresh.',
  disclaimer: 'Budget price based on past supplier offers; the same panel can differ 30–60% between suppliers. Use it as a first reference.',
};
const CATS = ['MDB', 'EMDB', 'SMDB', 'ESMDB', 'DB', 'EDB', 'LP', 'MCC', 'EMCC', 'PFC', 'ATS', 'PILLAR', 'COFFREE', 'LCP'];
---
<Base lang={lang} title={L.nav.pricing} description={S.lead}>
  <div class="container pricing" id="pricing" data-s={JSON.stringify({ ...S, dbInfo: undefined })} data-lang={lang}>
    <header class="page-head no-print">
      <span class="badge">⚡ {L.nav.pricing}</span>
      <h1 style="margin-top:12px">{S.title}</h1>
      <p>{S.lead}</p>
      <p class="pr-db" id="pr-db">{S.loading}</p>
    </header>

    <div class="pr-layout no-print">
      <form class="pr-form" id="pr-form" autocomplete="off" onsubmit="return false">
        <section class="pr-card">
          <h2><span class="pr-num">1</span>{S.panel}</h2>
          <div class="pr-grid">
            <label>{S.project}<input name="project" value="Project name" /></label>
            <label>{S.panelName}<input name="panel" value="MDB-01" /></label>
            <label>{S.type}<select name="category">{CATS.map((c) => <option value={c}>{c}</option>)}</select></label>
            <label>{S.mainType}<select name="mainType">{MAIN_TYPES.map((c) => <option>{c}</option>)}</select></label>
            <label>{S.mainA}<input name="mainA" type="number" min="1" step="any" value="1600" inputmode="decimal" /></label>
            <label>{S.mainPoles}<select name="mainPoles"><option>3</option><option>4</option></select></label>
            <label>{S.incomers}<input name="incomers" type="number" min="1" step="1" value="1" /><small>{S.incomersHint}</small></label>
            <label>{S.ip}<select name="ip">{IPS.map((c) => <option value={c} selected={c === 54}>IP{c}</option>)}</select></label>
            <label>{S.form}<select name="form">{FORMS.map((c) => <option value={c}>{c === 'auto' ? S.auto : c}</option>)}</select></label>
            <label>{S.brand}<select name="brand">{BRANDS.map((c) => <option value={c}>{c === 'Any' ? S.any : c}</option>)}</select></label>
            <label>{S.qty}<input name="qty" type="number" min="1" step="1" value="1" /></label>
            <label>{S.adj}<input name="adj" type="number" step="any" value="0" /></label>
            <label>{S.vfd}<input name="vfdExtra" type="number" min="0" step="1" value="0" /></label>
            <label>{S.pfc}<select name="pfc"><option value="no">{S.no}</option><option value="yes">{S.yes}</option></select></label>
            <label class="pfc-only">{S.kvar}<input name="kvar" type="number" min="0" step="any" value="300" /></label>
            <label class="pfc-only">{S.pfcType}<select name="pfcType"><option value="Standard">{S.std}</option><option value="Detuned">Detuned</option></select></label>
          </div>
        </section>

        <section class="pr-card">
          <h2><span class="pr-num">2</span>{S.outs}</h2>
          <div class="pr-table-wrap">
            <table class="pr-table">
              <thead><tr><th>#</th><th>{S.outType}</th><th>{S.outA}</th><th>{S.outPoles}</th><th>{S.outQty}</th><th></th></tr></thead>
              <tbody id="pr-lines"></tbody>
            </table>
          </div>
          <template id="pr-line-tpl"><table><tbody>
            <tr>
              <td class="pr-idx"></td>
              <td><select data-f="type" aria-label={S.outType}><option value="">—</option>{OUT_TYPES.map((c) => <option>{c}</option>)}</select></td>
              <td><input data-f="a" type="number" min="0" step="any" inputmode="decimal" aria-label={S.outA} /></td>
              <td><select data-f="poles" aria-label={S.outPoles}><option>1</option><option>2</option><option selected>3</option><option>4</option></select></td>
              <td><input data-f="qty" type="number" min="0" step="1" value="1" aria-label={S.outQty} /></td>
              <td><button type="button" class="pr-x" aria-label={S.remove}>×</button></td>
            </tr>
          </tbody></table></template>
          <div class="pr-actions">
            <button type="button" class="btn-ghost" id="pr-add">{S.addRow}</button>
            <button type="button" class="btn-ghost" id="pr-clear">{S.clear}</button>
          </div>
          <p class="pr-hint">{S.outsHint}</p>
        </section>
      </form>

      <aside class="pr-result" id="pr-result" aria-live="polite">
        <div class="pr-card pr-sticky">
          <h2><span class="pr-num">3</span>{S.result}</h2>
          <p class="pr-label">{S.unit}</p>
          <p class="pr-price"><span id="r-price">—</span> <small>{S.excl}</small></p>
          <div class="pr-range">
            <div><span>{S.lowL}</span><b id="r-low">—</b></div>
            <div class="pr-bar"><i id="r-mark"></i></div>
            <div><span>{S.highL}</span><b id="r-high">—</b></div>
          </div>
          <dl class="pr-dl">
            <div><dt>{S.total}</dt><dd id="r-total">—</dd></div>
            <div><dt>{S.usdL}</dt><dd id="r-usd">—</dd></div>
            <div><dt>{S.conf}</dt><dd><span class="pr-conf" id="r-conf">—</span></dd></div>
            <div><dt>{S.sim}</dt><dd id="r-sim">—</dd></div>
          </dl>
          <div class="pr-dims">
            <h3>📐 {S.dimsTitle}</h3>
            <div class="pr-dims-nums" dir="ltr">
              <div><b id="r-w">—</b><span>{S.wL}</span></div><i>×</i>
              <div><b id="r-h">—</b><span>{S.hL}</span></div><i>×</i>
              <div><b id="r-d">—</b><span>{S.dL}</span></div>
            </div>
            <p class="pr-dims-sub"><span id="r-mode">—</span> · {S.mm}</p>
            <div class="pr-elev" id="r-elev" dir="ltr" aria-hidden="true"></div>
            <p class="pr-hint" style="margin-top:8px">{S.legend}</p>
          </div>
          <details class="pr-details">
            <summary>{S.details}</summary>
            <dl class="pr-dl">
              <div><dt>{S.panelOnly}</dt><dd id="r-panel">—</dd></div>
              <div><dt>{S.pfcP}</dt><dd id="r-pfc">—</dd></div>
              <div><dt>{S.m1}</dt><dd id="r-m1">—</dd></div>
              <div><dt>{S.m2}</dt><dd id="r-m2">—</dd></div>
              <div><dt>{S.outsCount}</dt><dd id="r-outs">—</dd></div>
              <div><dt>{S.formUsed}</dt><dd id="r-form">—</dd></div>
              <div><dt>{S.brk}</dt><dd id="r-brk">—</dd></div>
              <div><dt>{S.dims}</dt><dd id="r-dims" dir="ltr">—</dd></div>
            </dl>
          </details>
          <button type="button" class="btn pr-offer-btn" id="pr-offer-btn">{S.offerBtn}</button>
          <p class="pr-hint">{S.disclaimer}</p>
        </div>
      </aside>
    </div>

    <section class="pr-offer-wrap" id="pr-offer-wrap" hidden>
      <div class="pr-card no-print pr-offer-opts">
        <h2>{S.offer}</h2>
        <div class="pr-grid">
          <label>{S.techBrand}<select name="techBrand" form="pr-form">{TECH_BRANDS.map((c) => <option>{c}</option>)}</select></label>
          <label>{S.spd}<select name="spd" form="pr-form"><option value="no">{S.no}</option><option value="yes">{S.yes}</option></select></label>
          <label>{S.cable}<select name="cableEntry" form="pr-form"><option>Bottom / Bottom</option><option>Top / Top</option><option>Bottom / Top</option><option>Top / Bottom</option></select></label>
          <label>{S.ka}<input name="kaOverride" type="number" min="0" step="any" form="pr-form" /></label>
          <label>{S.formO}<select name="formOverride" form="pr-form"><option value="">—</option>{FORMS.slice(1).map((c) => <option>{c}</option>)}</select></label>
          <label>{S.amb}<input name="ambient" type="number" step="any" value="40" form="pr-form" /></label>
        </div>
        <div class="offer-actions"><button type="button" class="btn" id="pr-print">🖨 {S.print}</button><button type="button" class="btn btn-outline" id="pr-xlsx">⬇ {S.excel}</button></div>
      </div>
      <article class="offer" id="pr-offer" dir="ltr" lang="en"></article>
    </section>
  </div>
</Base>

<script>
  import { Estimator, NOTES, type Data, type Input } from '../lib/pricing';
  import { downloadXlsx } from '../lib/excel';

  const root = document.getElementById('pricing')!;
  const S = JSON.parse(root.dataset.s!);
  const lang = root.dataset.lang;
  const form = document.getElementById('pr-form') as HTMLFormElement;
  const tbody = document.getElementById('pr-lines')!;
  const tpl = document.getElementById('pr-line-tpl') as HTMLTemplateElement;
  const $ = (id: string) => document.getElementById(id)!;
  const fmt = (x: number) => (isFinite(x) ? Math.round(x).toLocaleString('en-US') : '—');
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const STORE = 'wt-pricing-v1';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tweens = new WeakMap<HTMLElement, { from: number; raf: number }>();
  /** count the number up/down to its new value */
  function tween(el: HTMLElement, to: number) {
    const prev = tweens.get(el);
    const from = prev?.from ?? 0;
    if (prev) cancelAnimationFrame(prev.raf);
    if (reduce || !isFinite(from) || Math.abs(to - from) < 1) { el.textContent = fmt(to); tweens.set(el, { from: to, raf: 0 }); return; }
    const t0 = performance.now(), dur = 650;
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      const v = from + (to - from) * e;
      el.textContent = fmt(v);
      tweens.set(el, { from: k < 1 ? v : to, raf: k < 1 ? requestAnimationFrame(step) : 0 });
    };
    tweens.set(el, { from, raf: requestAnimationFrame(step) });
    el.classList.remove('flash'); void el.offsetWidth; el.classList.add('flash');
  }

  function addLine(l?: { type?: string; a?: number | string; poles?: number | string; qty?: number | string }) {
    const tr = (tpl.content.cloneNode(true) as DocumentFragment).querySelector('tr') as HTMLTableRowElement;
    if (l) for (const k of ['type', 'a', 'poles', 'qty'] as const) if (l[k] != null) (tr.querySelector(`[data-f=${k}]`) as HTMLInputElement).value = String(l[k]);
    tr.querySelector('.pr-x')!.addEventListener('click', () => { tr.remove(); renumber(); update(); });
    tbody.appendChild(tr);
    renumber();
  }
  function renumber() { tbody.querySelectorAll('.pr-idx').forEach((td, i) => (td.textContent = String(i + 1))); }

  function readInput(): Input {
    const f = new FormData(form);
    const g = (k: string) => String(f.get(k) ?? '');
    const lines = [...tbody.querySelectorAll('tr')].map((tr) => {
      const v = (k: string) => (tr.querySelector(`[data-f=${k}]`) as HTMLInputElement).value;
      return { type: v('type'), a: +v('a') || 0, poles: +v('poles') || 0, qty: +v('qty') || 0 };
    });
    return {
      project: g('project'), panel: g('panel'), category: g('category'), mainType: g('mainType'), mainA: +g('mainA') || 0,
      mainPoles: +g('mainPoles') || 3, incomers: +g('incomers') || 1, ip: g('ip') === '' ? '' : +g('ip'), form: g('form'), brand: g('brand'),
      vfdExtra: +g('vfdExtra') || 0, qty: +g('qty') || 1, adj: (+g('adj') || 0) / 100, pfc: g('pfc') === 'yes', kvar: +g('kvar') || 0,
      pfcType: g('pfcType') === 'Detuned' ? 'Detuned' : 'Standard', lines,
      techBrand: g('techBrand') || 'Schneider', kaOverride: +g('kaOverride') || 0, formOverride: g('formOverride'), cableEntry: g('cableEntry'),
      spd: g('spd') === 'yes', ambient: +g('ambient') || 40,
    };
  }

  function save(inp: Input) { try { localStorage.setItem(STORE, JSON.stringify(inp)); } catch {} }
  function restore(): boolean {
    let inp: any;
    try { inp = JSON.parse(localStorage.getItem(STORE) || 'null'); } catch {}
    if (!inp) return false;
    for (const [k, v] of Object.entries(inp)) {
      const el = form.elements.namedItem(k) as HTMLInputElement | null;
      if (!el || k === 'lines') continue;
      el.value = k === 'adj' ? String(Math.round(Number(v) * 10000) / 100) : typeof v === 'boolean' ? (v ? 'yes' : 'no') : String(v);
    }
    (inp.lines || []).forEach((l: any) => addLine(l));
    return true;
  }

  let est: Estimator | null = null;
  let offerOpen = false;

  function update() {
    root.classList.toggle('pfc-on', (form.elements.namedItem('pfc') as HTMLSelectElement).value === 'yes');
    if (!est) return;
    const inp = readInput();
    save(inp);
    let r;
    try { r = est.calc(inp); } catch (e) { console.error(e); return; }
    tween($('r-price'), r.price);
    tween($('r-low'), r.low);
    tween($('r-high'), r.high);
    const pos = r.high > r.low ? ((r.price - r.low) / (r.high - r.low)) * 100 : 50;
    ($('r-mark') as HTMLElement).style.insetInlineStart = `${Math.min(100, Math.max(0, pos))}%`;
    $('r-total').textContent = `${fmt(r.qtyTotal)} EGP`;
    $('r-usd').textContent = `$ ${fmt(r.usd)}`;
    const conf = $('r-conf');
    conf.textContent = S.confT[r.confidence];
    conf.dataset.level = r.confidence;
    $('r-sim').textContent = `${Math.round(r.similarity * 100)}%`;
    $('r-panel').textContent = fmt(r.panelOnly);
    $('r-pfc').textContent = r.pfcPrice > 0 ? `${fmt(r.pfcPrice)} (${r.pfc.kvar} kVAR – ${r.pfc.type})` : '—';
    $('r-m1').textContent = fmt(r.similar);
    $('r-m2').textContent = fmt(r.model);
    $('r-outs').textContent = String(+r.counts.total.toFixed(2));
    $('r-form').textContent = `${r.form} (×${r.formFactor.toFixed(2)})`;
    $('r-brk').textContent = `${fmt(r.breakersCost)} (×${r.ratio.toFixed(1)})`;
    $('r-dims').textContent = r.dims.text;
    $('r-w').textContent = fmt(r.dims.W);
    $('r-h').textContent = fmt(r.dims.H);
    $('r-d').textContent = fmt(r.dims.D);
    $('r-mode').textContent = `${S.modeT[r.dims.mode]}${r.dims.mode === 'FLOOR' ? ` · ${S.colsL}: ${r.dims.columns}` : ''}`;
    const tot = r.dims.layout.reduce((s, c) => s + c.w, 0) || 1;
    const hPct = Math.min(100, Math.max(35, (r.dims.H / 2200) * 100));
    $('r-elev').innerHTML = `<div class="pr-elev-box" style="height:${hPct * 1.3}px">${r.dims.layout
      .map((c) => `<div class="pr-col pr-col-${c.code[0]}" style="flex:${c.w / tot}"><b>${esc(c.label)}</b><small>${fmt(c.w)}</small></div>`).join('')}</div>`;
    if (offerOpen) renderOffer(inp, r);
  }

  function renderOffer(inp: Input, r: ReturnType<Estimator['calc']>) {
    const o = est!.offer(inp, r);
    const d = est!.d;
    const schneider = inp.techBrand === 'Schneider';
    const g = o.general;
    const pairs = [];
    for (let i = 0; i < g.length; i += 2) pairs.push(`<tr><th>${esc(g[i][0])}</th><td>${esc(g[i][1])}</td><th>${esc(g[i + 1]?.[0] ?? '')}</th><td>${esc(g[i + 1]?.[1] ?? '')}</td></tr>`);
    const rows = o.items.map((it) => it.head
      ? `<tr class="o-head"><td colspan="${schneider ? 10 : 8}">${esc(it.head)}</td></tr>`
      : `<tr><td>${it.no}</td><td>${esc(it.qty)}</td><td class="o-desc">${esc(it.desc)}</td><td>${esc(it.rating)}</td><td>${esc(it.poles)}</td><td>${esc(it.icu)}</td><td>${esc(it.brand)}</td><td>${esc(it.ref)}</td>${schneider ? `<td class="o-num">${typeof it.unit === 'number' ? fmt(it.unit) : ''}</td><td class="o-num">${typeof it.total === 'number' ? fmt(it.total) : ''}</td>` : ''}</tr>`).join('');
    $('pr-offer').innerHTML = `
      <header class="o-top">
        <img src="/logo-96.webp" alt="" width="64" height="64" />
        <div><h2>PROPOSED TECHNICAL OFFER – LV PANEL</h2><p>Components: ${esc(inp.techBrand)} • ${esc(o.enclosure)}</p></div>
      </header>
      <table class="o-info">
        <tr><th>Project</th><td>${esc(inp.project)}</td><th>Date</th><td>${esc(d.meta.priceDate)}</td></tr>
        <tr><th>Panel name</th><td>${esc(inp.panel)}</td><th>Offer ref.</th><td>${esc(o.ref)}</td></tr>
        <tr><th>Panel type</th><td>${esc(o.typeText)}</td><th>Quantity</th><td>${inp.qty}</td></tr>
        <tr><th>Components brand</th><td>${esc(inp.techBrand)}</td><th>Est. price / panel</th><td><b>${fmt(r.techPrice)} EGP</b></td></tr>
        <tr><th>Enclosure</th><td>${esc(o.enclosure)}</td><th>Est. total (qty)</th><td><b>${fmt(r.techPrice * inp.qty)} EGP</b></td></tr>
        <tr><th>Prepared by</th><td>Watt's Tender</td><th>PFC</th><td>${r.pfc.on ? `${r.pfc.kvar} kVAR (${r.pfc.type})` : 'None'}</td></tr>
      </table>
      <h3>1. GENERAL SPECIFICATIONS</h3>
      <table class="o-info">${pairs.join('')}</table>
      <h3>2. BILL OF MATERIALS</h3>
      <div class="o-scroll"><table class="o-bom">
        <thead><tr><th>Item</th><th>Qty</th><th>Description</th><th>Rating</th><th>Poles</th><th>Icu</th><th>Brand</th><th>Typical ref.</th>${schneider ? '<th>Unit list price EGP (PL 2026)</th><th>Total list EGP</th>' : ''}</tr></thead>
        <tbody>${rows}</tbody>
        ${schneider ? `<tfoot><tr><td colspan="9">Total list price of the priced components – Schneider PL 2026 (EGP, excl. VAT, before discount; enclosure, busbar, wiring & labour not included)</td><td class="o-num">${fmt(o.listTotal ?? 0)}</td></tr></tfoot>` : ''}
      </table></div>
      <h3>3. NOTES & EXCLUSIONS</h3>
      <ol class="o-notes">${NOTES.map((n) => `<li>${esc(n)}</li>`).join('')}</ol>`;
  }

  $('pr-add').addEventListener('click', () => { addLine(); update(); });
  $('pr-clear').addEventListener('click', () => { tbody.innerHTML = ''; addLine(); update(); });
  form.addEventListener('input', update);
  form.addEventListener('change', update);
  document.querySelectorAll('[form="pr-form"]').forEach((el) => { el.addEventListener('input', update); el.addEventListener('change', update); });
  $('pr-offer-btn').addEventListener('click', () => {
    offerOpen = true;
    ($('pr-offer-wrap') as HTMLElement).hidden = false;
    update();
    $('pr-offer-wrap').scrollIntoView({ behavior: 'smooth' });
  });
  $('pr-print').addEventListener('click', () => window.print());
  $('pr-xlsx').addEventListener('click', () => {
    if (!est) return;
    const inp = readInput(), r = est.calc(inp), o = est.offer(inp, r);
    const sum: (string | number)[][] = [
      ["Watt's Tender — LV Panel Budget Estimate"], [],
      ['Project', inp.project], ['Panel', inp.panel], ['Panel type', o.typeText], ['Main breaker', `${inp.mainType} ${inp.mainA} A ${inp.mainPoles}P × ${inp.incomers}`],
      ['IP', inp.ip === '' ? '' : `IP${inp.ip}`], ['Quantity', inp.qty], [],
      ['Suggested price / panel (EGP excl. VAT)', Math.round(r.price)], ['Low', Math.round(r.low)], ['High', Math.round(r.high)],
      ['Total for quantity', Math.round(r.qtyTotal)], ['USD (reference)', Math.round(r.usd)], ['Confidence', r.confidence], ['Similarity', `${Math.round(r.similarity * 100)}%`],
      ['Dimensions', r.dims.text], ['Arrangement', r.dims.mount], ['Form', r.form], [],
      ['Outgoing breakers'], ['Type', 'Rating', 'Poles', 'Qty'], ...inp.lines.filter((l) => l.type).map((l) => [l.type, l.a, l.poles, l.qty]),
    ];
    const bom: (string | number)[][] = [['Item', 'Qty', 'Description', 'Rating', 'Poles', 'Icu', 'Brand', 'Typical ref.', 'Unit list EGP', 'Total list EGP'],
      ...o.items.map((it) => it.head ? ['', '', it.head] : [it.no ?? '', it.qty ?? '', it.desc, it.rating ?? '', it.poles ?? '', it.icu ?? '', it.brand ?? '', it.ref ?? '', it.unit ?? '', it.total ?? ''])];
    const spec = o.general.map(([k, v]) => [k, v]);
    downloadXlsx(`${inp.panel || 'panel'} - estimate.xlsx`, [{ name: 'Estimate', rows: sum }, { name: 'Technical offer', rows: [...spec, [], ...bom] }]);
  });

  if (!restore()) {
    [{ type: 'MCCB', a: 630, qty: 2 }, { type: 'MCCB', a: 400, qty: 2 }, { type: 'MCCB', a: 250, qty: 4 }, { type: 'MCCB', a: 160, qty: 2 }].forEach((l) => addLine({ ...l, poles: 3 }));
  }
  update();

  fetch('/pricing/data.json')
    .then((r) => r.json())
    .then((d: Data) => {
      est = new Estimator(d);
      $('pr-db').textContent = lang === 'ar'
        ? `مبني على ${d.meta.panels.toLocaleString('en-US')} لوحة من ${d.meta.offers} عرض سعر حقيقي — أسعار محدّثة لتاريخ ${d.meta.priceDate} — الدولار ${d.meta.usd}`
        : `Based on ${d.meta.panels.toLocaleString('en-US')} panels from ${d.meta.offers} real supplier offers — prices as of ${d.meta.priceDate} — USD ${d.meta.usd}`;
      update();
    })
    .catch(() => { $('pr-db').textContent = S.err; });
</script>
