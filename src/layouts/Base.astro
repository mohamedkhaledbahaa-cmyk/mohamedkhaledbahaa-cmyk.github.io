---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
import { altPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** رابط نفس الصفحة باللغة الأخرى (لو مش موجودة، استخدم الرئيسية) */
  altHref?: string;
}
const { lang, title, image, type = 'website', publishedTime } = Astro.props;
const L = t(lang);
const description = Astro.props.description ?? L.description;
const altHref = Astro.props.altHref ?? altPath(Astro.url.pathname);
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} — ${L.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// social networks don't render SVG previews — use the JPG twin generated by tools/svg_to_jpg.cjs
const ogImage = new URL((image ?? '/og-default.jpg').replace(/\.svg$/, '.jpg'), Astro.site).href;
const otherLang = lang === 'ar' ? 'en' : 'ar';
---
<!doctype html>
<html lang={lang} dir={L.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={new URL(altHref, Astro.site)} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0d1320" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- fonts load without blocking the first paint; only the weights actually used -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Inter:wght@400;600;700&family=Noto+Naskh+Arabic&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&text=Watt%27s%20Tender&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Inter:wght@400;600;700&family=Noto+Naskh+Arabic&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" /></noscript>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only">{L.skip}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <script is:inline>
      // Pause the hero animations while the hero is off-screen (saves CPU/battery while scrolling)
      (function () {
        var h = document.querySelector('.hero');
        if (!h || !('IntersectionObserver' in window)) return;
        new IntersectionObserver(function (e) { h.classList.toggle('anim-paused', !e[0].isIntersecting); }).observe(h);
      })();
      // Scroll-reveal: elements below the first screen fade up as they enter the viewport.
      // Fail-safe: content already on screen is never hidden, and everything is shown after 2.5 s
      // even if IntersectionObserver misbehaves (old phones, in-app browsers).
      (function () {
        try {
          if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var sel = '.card, .featured, .section-head, .chips, .newsletter, .pr-card, .author-box, .post-nav, .search-item, .article-cover, .prose > h2, .page-head';
          var els = document.querySelectorAll(sel), vh = window.innerHeight || 800, list = [];
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('rv-in'); io.unobserve(e.target); } });
          }, { rootMargin: '0px 0px -5% 0px', threshold: 0.01 });
          for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (el.getBoundingClientRect().top < vh) continue; // visible at load: leave it alone
            var idx = el.parentElement ? Array.prototype.indexOf.call(el.parentElement.children, el) : 0;
            el.style.setProperty('--rv-delay', Math.min(idx, 6) * 70 + 'ms');
            el.classList.add('rv');
            io.observe(el);
            list.push(el);
          }
          setTimeout(function () { for (var j = 0; j < list.length; j++) list[j].classList.add('rv-in'); }, 2500);
        } catch (e) {
          var h = document.querySelectorAll('.rv');
          for (var k = 0; k < h.length; k++) h[k].classList.add('rv-in');
        }
      })();
    </script>
  </body>
</html>
